{
  "name": "lgtm-review",
  "version": "0.1.0",
  "description": "Review what a coding agent did in a Claude Code session",
  "repository": {
    "type": "git",
    "url": "https://github.com/jack2k0/lgtm-review.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jack2k0/lgtm-review#readme",
  "bugs": {
    "url": "https://github.com/jack2k0/lgtm-review/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "lgtm-review": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-web.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke-pack.mjs",
    "test": "vitest run --exclude '**/*.perf.test.ts'",
    "test:perf": "vitest run perf.test"
  },
  "devDependencies": { "@lgtm/core": "workspace:*", "@types/node": "^22.0.0", "tsup": "^9.0.0", "typescript": "^5.8.0", "vitest": "^4.1.12" }
}
