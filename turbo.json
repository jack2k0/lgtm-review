{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "lgtm-review#build": { "dependsOn": ["^build", "@lgtm/web#build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build", "build"] },
    "test:perf": { "dependsOn": ["^build", "build"], "cache": false },
    "test:coverage": { "dependsOn": ["^build", "build"] },
    "smoke": { "dependsOn": ["build"], "cache": false },
    "lint": {}
  }
}
